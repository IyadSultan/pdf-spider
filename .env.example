# Copy this file to .env for a local trial.
# On Replit, put the same names in the Secrets panel instead.

# A long random string. This keeps people signed in between restarts.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# true shows error details. Use false on the public Replit app.
DJANGO_DEBUG=true

# Who is allowed to open the site. Replit host names are already included in settings.py.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional extra https:// origins, separated by commas.
CSRF_TRUSTED_ORIGINS=

# Leave blank to use keyword search only. Text searches still count toward the 10 uses.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
